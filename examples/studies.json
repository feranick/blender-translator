{
 "bracket_hero": {
  "objects": [{"name": "bracket", "material": "anodised", "color": "#7f8c99",
               "source": {"goal": {"features": [{"kind": "base_box", "params": {"w": 80, "d": 40, "h": 10}},
                                                {"kind": "hole", "params": {"r": 4, "x": 25, "y": 0}},
                                                {"kind": "hole", "params": {"r": 4, "x": -25, "y": 0}}]}}}],
  "views": [{"name": "iso", "view": "iso"}],
  "lights": "studio", "background": "floor",
  "output": {"width": 1920, "height": 1080, "samples": 128}},

 "datasheet": {
  "objects": [{"name": "plate", "material": "metal_brushed",
               "source": {"goal": {"features": [{"kind": "base_box", "params": {"w": 60, "d": 30, "h": 6}},
                                                {"kind": "hole", "params": {"r": 3, "x": 20, "y": 0}}]}}}],
  "views": [{"name": "front", "view": "front", "projection": "ortho"},
            {"name": "top", "view": "top", "projection": "ortho"},
            {"name": "iso", "view": "iso", "fit": 0.8}],
  "background": "white", "output": {"width": 1200, "height": 900, "samples": 96}},

 "assembly": {
  "objects": [{"name": "housing", "material": "plastic", "color": "#9aa0a6",
               "source": {"goal": {"features": [{"kind": "base_box", "params": {"w": 50, "d": 50, "h": 20}}]}}},
              {"name": "lid", "material": "plastic", "color": "#202124", "at": [70, 0, 0],
               "source": {"goal": {"features": [{"kind": "base_box", "params": {"w": 50, "d": 50, "h": 4}}]}}}],
  "views": [{"name": "iso", "view": "iso"}, {"name": "lid_close", "view": "iso", "target": "lid", "fit": 0.6}],
  "background": "transparent", "output": {"width": 1600, "height": 1200, "samples": 128}, "blend": true},

 "flat_diagram": {
  "objects": [{"name": "cube", "source": {"box": [20, 20, 20]}, "color": "#3366cc"},
              {"name": "ball", "source": {"sphere": 8}, "at": [30, 0, 0], "color": "#cc6633"}],
  "views": [{"name": "front", "view": "front", "projection": "ortho"}],
  "lights": "flat", "background": "white", "output": {"width": 800, "height": 600, "samples": 16, "denoise": false},
  "expect": [{"quantity": "objects.cube.volume_mm3", "value": 8000, "tol": 1e-9}]}
}
